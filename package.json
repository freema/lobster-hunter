{
  "name": "lobster-hunter",
  "version": "1.0.2",
  "description": "Security scanner to identify ClawdBot Gateway instances lacking authentication (https://clawd.bot)",
  "bin": {
    "lobster-hunter": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run format:check",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "security",
    "scanner",
    "clawdbot",
    "network",
    "websocket",
    "pentest",
    "security-tools"
  ],
  "author": "freema",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/freema/lobster-hunter.git"
  },
  "bugs": {
    "url": "https://github.com/freema/lobster-hunter/issues"
  },
  "homepage": "https://github.com/freema/lobster-hunter#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
